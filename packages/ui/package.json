{
  "name": "unipo-ui",
  "version": "1.8.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "node build-css.mjs && tsup && node add-use-client.mjs && node scripts/katalog/rapikan-dist.mjs && node gen-registry.mjs",
    "build:css": "node build-css.mjs",
    "katalog": "node scripts/katalog/buat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "unipo-siakad-sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "unipo-siakad-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.73.0",
    "country-flag-icons": "1.6.20",
    "unipo-ui-tokens": "1.8.0"
  },
  "devDependencies": {
    "sass": "1.108.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "unipo-siakad-sdk": "1.0.0",
    "date-fns": "4.4.0",
    "@date-fns/tz": "1.5.0"
  },
  "description": "Komponen UI UNIPO: CSS kelas u-* (framework-agnostic) dan komponen React di atas Base UI, terhubung ke SDK SIAKAD.",
  "license": "MIT",
  "author": "Pustikom Universitas Pohuwato",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./siakad": {
      "import": {
        "types": "./dist/siakad.d.ts",
        "default": "./dist/siakad.js"
      },
      "require": {
        "types": "./dist/siakad.d.cts",
        "default": "./dist/siakad.cjs"
      }
    },
    "./katalog": {
      "import": {
        "types": "./dist/katalog.d.ts",
        "default": "./dist/katalog.js"
      },
      "require": {
        "types": "./dist/katalog.d.cts",
        "default": "./dist/katalog.cjs"
      }
    },
    "./ikon": {
      "import": {
        "types": "./dist/ikon.d.ts",
        "default": "./dist/ikon.js"
      },
      "require": {
        "types": "./dist/ikon.d.cts",
        "default": "./dist/ikon.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    },
    "./tema": {
      "import": {
        "types": "./dist/tema.d.ts",
        "default": "./dist/tema.js"
      },
      "require": {
        "types": "./dist/tema.d.cts",
        "default": "./dist/tema.cjs"
      }
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/ui-unipo.css"
    },
    "./css/min": {
      "types": "./dist/css.d.ts",
      "default": "./dist/ui-unipo.min.css"
    },
    "./scss": "./dist/scss/index.scss",
    "./package.json": "./package.json",
    "./registry.json": "./dist/registry.json"
  },
  "files": [
    "dist",
    "src",
    "!src/katalog/data/modul",
    "cli",
    "README.md"
  ],
  "bin": {
    "unipo-ui": "./cli/index.mjs"
  },
  "keywords": [
    "unipo",
    "siakad",
    "ui",
    "react",
    "components",
    "design-system",
    "base-ui",
    "nextjs",
    "scss",
    "less",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anasamu/ui-unipo.git",
    "directory": "packages/ui"
  },
  "homepage": "https://api.unipo.ac.id/docs/panduan/ui",
  "bugs": {
    "url": "https://github.com/anasamu/ui-unipo/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
