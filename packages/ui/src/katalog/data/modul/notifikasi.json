g":"Notifikasi: Kotak masuk","sum":"Bersihkan notifikasi","ds":"Hapus lunak milik pemanggil. Body {cakupan: dibaca|semua|pilih, modul?, id?: [..]}. Jawaban {dibersihkan, id} untuk urungkan.","sc":["notif:write"],"r":"object","it":"Objek"},"postNotifKotakPulihkan":{"id":"postNotifKotakPulihkan","m":"POST","path":"/v1/notif/kotak/pulihkan","tag":"Notifikasi: Kotak masuk","sum":"Urungkan bersihkan","ds":"Body {id: [..]}: pulihkan milik pemanggil yang dibersihkan dalam 24 jam terakhir.","sc":["notif:write"],"r":"object","it":"Objek"},"postNotifKotakBisu":{"id":"postNotifKotakBisu","m":"POST","path":"/v1/notif/kotak/bisu","tag":"Notifikasi: Kotak masuk","sum":"Bisukan label","ds":"Body {modul, bisu: bool}. Label yang dibisukan tidak dihitung di lencana dan tidak tampil di tab Semua; notifikasinya tetap ada di tab labelnya.","sc":["notif:write"],"r":"object","it":"Objek"},"postNotifKirim":{"id":"postNotifKirim","m":"POST","path":"/v1/notif/kirim","tag":"Notifikasi: Kotak masuk","sum":"Kirim notifikasi","ds":"Untuk aplikasi lain atau pengelola: body {\"username\": [..], \"judul\", \"isi\", \"tautan\", \"modul\"}. Masuk kotak masuk penerima dan antrean kanal sesuai preferensi mereka.","sc":["notif:write"],"r":"object","it":"Objek"},"getNotifRealtime":{"id":"getNotifRealtime","m":"GET","path":"/v1/notif/realtime","tag":"Notifikasi: Realtime","sum":"Konfigurasi realtime","ds":"Penyedia WebSocket aktif (Pustikom » Integrasi » Realtime) tanpa secret: driver, key, host, port, tls, cluster, nama kanal privat milik pemanggil, nama event, dan jeda polling cadangan. `aktif: false` = belum ada penyedia aktif; aplikasi tetap memakai long-poll/polling.","sc":["notif:read"],"r":"object","it":"Objek"},"postNotifRealtimeAuth":{"id":"postNotifRealtimeAuth","m":"POST","path":"/v1/notif/realtime/auth","tag":"Notifikasi: Realtime","sum":"Otorisasi kanal privat","ds":"Body {socket_id, channel_name}. Menandatangani langganan (protokol Pusher) hanya untuk kanal milik pemanggil; kanal lain 403. Jawaban {auth}.","sc":["notif:read"],"r":"object","it":"Objek"},"getNotifPita":{"id":"getNotifPita","m":"GET","path":"/v1/notif/pita","tag":"Notifikasi: Pengumuman","sum":"Pengumuman aktif","ds":"Pengumuman yang sedang tayang untuk pemanggil di aplikasi ini (sasaran aplikasi, unit, peran termasuk jenis akun `akun:*`, jadwal; yang sudah ditutup atau dihapus tidak ikut). Tautan konten portal di-resolve ke alamat baca terbaru. Tanpa token pengguna = hanya yang ditandai publik.","pub":1,"pa":[{"nm":"aplikasi","in":"query","s":{"t":"string"},"ds":"Kode aplikasi pemanggil, mis. baak, pmb, siakad-lama, publik"},{"nm":"situs","in":"query","s":{"t":"string"},"ds":"Kode situs portal (publik): pengumuman publik milik unit hanya tayang di situs unit itu"}],"r":"list","it":"Objek"},"postNotifPitaByIdTutup":{"id":"postNotifPitaByIdTutup","m":"POST","path":"/v1/notif/pita/{id}/tutup","tag":"Notifikasi: Pengumuman","sum":"Tutup pengumuman","ds":"Tidak tampil lagi untuk akun ini di semua aplikasi.","sc":["notif:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"UUID pengumuman"}],"r":"object","it":"Objek"},"getNotifPitaKelola":{"id":"getNotifPitaKelola","m":"GET","path":"/v1/notif/pita/kelola","tag":"Notifikasi: Pengumuman","sum":"Daftar pengumuman yang dikelola","ds":"Admin/izin pengumuman:kelola global: semua; izin berlingkup unit: milik unitnya. Berisi status tayang (aktif, terjadwal, berakhir, draf, arsip), `publik`, dan `tautan_ref` (konten portal yang dirujuk). Yang dihapus tidak ikut.","sc":["notif:write"],"pa":[{"nm":"status","in":"query","s":{"t":"string"},"ds":"draf | terbit | arsip"}],"r":"list","it":"Objek"},"postNotifPitaKelola":{"id":"postNotifPitaKelola","m":"POST","path":"/v1/notif/pita/kelola","tag":"Notifikasi: Pengumuman","sum":"Buat pengumuman","ds":"Body {judul, isi?, tautan?, teks_tautan?, nada, mode: pita|banner|popup|toast|bawah, gambar?, opsi?: {ulang: sekali|sesi, hilang_detik}, mulai?, selesai?, dapat_ditutup?, prioritas?, status: draf|terbit|arsip, aplikasi?: [kode], unit?: [kode], peran?: [kode RBAC atau akun:mahasiswa|akun:dosen|akun:tendik|akun:alumni|akun:pendaftar], publik?: bool (tampil juga tanpa login), tautan_ref?: {jenis: berita|pengumuman|agenda|halaman, id} (konten portal terbit; tautan = URL manual hanya untuk pembuat tingkat universitas)}. Kosong = semua akun yang masuk. `jenis` lama masih diterima: jenis akun dipinda","sc":["notif:write"],"r":"object","it":"Objek"},"getNotifPitaHak":{"id":"getNotifPitaHak","m":"GET","path":"/v1/notif/pita/hak","tag":"Notifikasi: Pengumuman","sum":"Hak membuat pengumuman","ds":"semua (boleh semua sasaran), publik (boleh menandai publik), unit (unit yang boleh disasar), tautan_manual (boleh URL bebas), peran_akun (peran khusus jenis akun untuk sasaran peran).","sc":["notif:write"],"r":"object","it":"Objek"},"postNotifPitaKelolaById":{"id":"postNotifPitaKelolaById","m":"POST","path":"/v1/notif/pita/kelola/{id}","tag":"Notifikasi: Pengumuman","sum":"Ubah pengumuman","sc":["notif:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/notif/pita/kelola","k":"id","d":"/v1/notif/pita/kelola/{id}"}},"rq":1,"ds":"UUID pengumuman"}],"r":"object","it":"Objek"},"postNotifPitaKelolaByIdHapus":{"id":"postNotifPitaKelolaByIdHapus","m":"POST","path":"/v1/notif/pita/kelola/{id}/hapus","tag":"Notifikasi: Pengumuman","sum":"Hapus pengumuman","ds":"Hapus lunak (deleted_at): hilang dari daftar kelola dan semua aplikasi.","sc":["notif:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/notif/pita/kelola","k":"id","d":"/v1/notif/pita/kelola/{id}"}},"rq":1,"ds":"UUID pengumuman"}],"r":"object","it":"Objek"},"getNotifPitaTautan":{"id":"getNotifPitaTautan","m":"GET","path":"/v1/notif/pita/tautan","tag":"Notifikasi: Pengumuman","sum":"Pilihan tautan Selengkapnya","ds":"Konten portal terbit yang boleh dirujuk pemanggil (pembuat unit: situs unitnya dan situs universitas): jenis, id, judul, situs, tanggal, url (alamat baca). Konten tanpa alamat baca