i:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/presensi/sesi","k":"id","d":"/v1/presensi/sesi/{id}"}},"rq":1,"ds":"UUID atau ID sesi"}],"r":"object","it":"Objek"},"postPresensiSesiByIdPeserta":{"id":"postPresensiSesiByIdPeserta","m":"POST","path":"/v1/presensi/sesi/{id}/peserta","tag":"Presensi QR: Peserta","sum":"Isi/koreksi status peserta","ds":"`{\"peserta\": [{\"jenis\": \"mahasiswa\", \"subjek\": \"NIM\", \"status\": \"I\", \"catatan\": \"...\"}], \"lainnya\": \"A\"}`. `lainnya` mengisi peserta daftar yang belum punya status. Pengelola atau petugas, sebelum disahkan.","sc":["presensi:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/presensi/sesi","k":"id","d":"/v1/presensi/sesi/{id}"}},"rq":1,"ds":"UUID atau ID sesi"}],"b":{"ct":"application/json","ref":"Objek","s":{"t":"object","ds":"Baris data dengan nama kolom huruf kecil sesuai tabel SIAKAD."},"rq":1},"r":"object","it":"Objek"},"postPresensiSesiByIdPindaiKartu":{"id":"postPresensiSesiByIdPindaiKartu","m":"POST","path":"/v1/presensi/sesi/{id}/pindai-kartu","tag":"Presensi QR: Peserta","sum":"Pindai kartu QR peserta (petugas)","ds":"`{\"token\": \"<isi kartu QR>\"}`. Untuk peserta tanpa kamera/ponsel atau acara dengan meja registrasi. Lokasi tidak diperiksa (petugas di lokasi).","sc":["presensi:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/presensi/sesi","k":"id","d":"/v1/presensi/sesi/{id}"}},"rq":1,"ds":"UUID atau ID sesi"}],"b":{"ct":"application/json","ref":"Objek","s":{"t":"object","ds":"Baris data dengan nama kolom huruf kecil sesuai tabel SIAKAD."},"rq":1},"r":"object","it":"PresensiPindaiHasil"},"postPresensiSesiByIdCuriga":{"id":"postPresensiSesiByIdCuriga","m":"POST","path":"/v1/presensi/sesi/{id}/curiga","tag":"Presensi QR: Peserta","sum":"Hapus tanda curiga","ds":"`{\"jenis\", \"subjek\", \"catatan\"}` setelah pengelola memeriksa (mis. dua mahasiswa berbagi ponsel dengan alasan sah).","sc":["presensi:write"],"pa":[{"nm":"id","in"