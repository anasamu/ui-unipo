ldren":[]},{"id":"/v1/kasir/unit","tag":"Kasir: Pengaturan","title":"Unit","base":"/v1/kasir/unit","list":"getKasirUnit","actions":[],"children":[]}],"ops":{"getKasirSaya":{"id":"getKasirSaya","m":"GET","path":"/v1/kasir/saya","tag":"Kasir: Sesi","sum":"Hak akses dan menu kasir saya","ds":"Izin kasir.* beserta unit, menu yang tampil (kasir, riwayat, laporan, pengaturan, migrasi), jenis biaya yang boleh diterima/dilaporkan, perangkat (header X-Kasir-Perangkat), kop PT + logo, jam server.","sc":["kasir:read"],"r":"object","it":"Objek"},"getKasirPerangkat":{"id":"getKasirPerangkat","m":"GET","path":"/v1/kasir/perangkat","tag":"Kasir: Pengaturan","sum":"Daftar perangkat kasir (lama)","ds":"Sama dengan GET /kelola/perangkat.","sc":["kasir:read"],"r":"list","it":"Objek"},"postKasirPerangkat":{"id":"postKasirPerangkat","m":"POST","path":"/v1/kasir/perangkat","tag":"Kasir: Sesi","sum":"Daftarkan perangkat","ds":"Body: {\"perangkat_id\", \"nama\", \"unit_id\" (unit yang diminta), \"catatan\", \"ajukan_ulang\", \"versi\", \"os\", \"kunci_publik\" (PEM ECDSA P-256), \"sidik\": {\"nama_komputer\", \"os\", \"arch\", \"versi\", \"pengguna_os\"}}. Wajib ditandatangani kunci yang didaftarkan (header X-Kasir-Perangkat/-Waktu/-Tanda, docs/KASIR.md). Komputer baru mendapat kode loket K01, K02, ... berstatus menunggu dan penyetuju (kasir.perangkat.setujui) diberi notifikasi. Kunci berganti = menunggu lagi.","sc":["kasir:write"],"r":"object","it":"Objek"},"getKasirSesi":{"id":"getKasirSesi","m":"GET","path":"/v1/kasir/sesi","tag":"Kasir: Sesi","sum":"Status perangkat & sesi kasir","ds":"Perangkat pengirim (status persetujuan, terverifikasi tanda), sesi terbuka beserta rekap sementara, boleh_buka.","sc":["kasir:read"],"r":"object","it":"Objek"},"postKasirSesiBuka":{"id":"postKasirSesiBuka","m":"POST","path":"/v1/kasir/sesi/buka","tag":"Kasir: Sesi","sum":"Buka sesi kasir","ds":"Body: {\"saldo_awal\", \"catatan\"}. Hanya perangkat DISETUJUI dengan tanda sah (403 perangkat_belum_disetujui); satu sesi per perangkat dan per petugas (409).","sc":["kasir:write"],"r":"object","it":"Objek"},"getKasirSesiRiwayat":{"id":"getKasirSesiRiwayat","m":"GET","path":"/v1/kasir/sesi/riwayat","tag":"Kasir: Sesi","sum":"Riwayat sesi saya","ds":"Sesi petugas di perangkat ini (?semua=1 = semua perangkat), 30 terbaru.","sc":["kasir:read"],"pa":[{"nm":"semua","in":"query","s":{"t":"string"},"ds":"1 = semua perangkat"}],"r":"list","it":"Objek"},"getKasirSesiById":{"id":"getKasirSesiById","m":"GET","path":"/v1/kasir/sesi/{id}","tag":"Kasir: Sesi","sum":"Rekap sesi","ds":"Per metode, per jenis biaya, pembayaran di muka, batal, kas seharusnya, uang fisik, setoran, selisih.","sc":["kasir:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"keu_mhs_transaksi.id"}],"r":"object","it":"Objek"},"postKasirSesiByIdTutup":{"id":"postKasirSesiByIdTutup","m":"POST","path":"/v1/kasir/sesi/{id}/tutup","tag":"Kasir: Sesi","sum":"Tutup sesi kasir","ds":"Body: {\"uang_fisik\", \"setoran\", \"catatan\"}. selisih = uang_fisik - (saldo_awal + tunai diterima). Hanya dari perangkat sesi itu.","sc":["kasir:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"keu_mhs_transaksi.id"}],"r":"object","it":"Objek"},"getKasirMahasiswa":{"id":"getKasirMahasiswa","m":"GET","path":"/v1/kasir/mahasiswa","tag":"Kasir: Penerimaan","sum":"Cari mahasiswa","ds":"NIM atau nama (min. 3 karakter), maks. 30 baris. status_label, bisa_diproses, alasan, tunggakan per baris.","sc":["kasir:read"],"pa":[{"nm":"q","in":"query","s":{"t":"string"},"ds":"NIM/nama"}],"r":"list","it":"Objek"},"getKasirMahasiswaByNim":{"id":"getKasirMahasiswaByNim","m":"GET","path":"/v1/kasir/mahasiswa/{nim}","tag":"Kasir: Penerimaan","sum":"Mahasiswa, tagihan, tunggakan, dan riwayat bayar","ds":"Hanya jenis biaya terbitan unit petugas. tagihan[].boleh/alasan dan jenis[].proses = hasil aturan penerimaan & jadwal; tunggakan = per periode akademik (tertua dulu).","sc":["kasir:read"],"pa":[{"nm":"nim","in":"path","s":{"t":"string","rf":{"l":"/v1/kasir/mahasiswa","k":"nim","d":"/v1/kasir/mahasiswa/{nim}"}},"rq":1,"ds":"NIM"}],"r":"object","it":"Objek"},"postKasirBayar":{"id":"postKasirBayar","m":"POST","path":"/v1/kasir/bayar","tag":"Kasir: Penerimaan","sum":"Terima pembayaran","ds":"Body: {\"uuid\", \"nim\", \"kode_biaya\", \"jumlah\", \"potongan\", \"ket_potongan\", \"tahun_id\" (bawaan: periode tagihan), \"metode\": \"tunai|transfer|va|lainnya\", \"referensi\", \"keterangan\"}. Idempoten per uuid (status \"sudah\" bila pernah tercatat, mis. dikirim ulang saat koneksi putus). Ditulis ke t_mahasiswa_bayar lewat langkah popup input pembayaran. Tagihan otomatis hanya bila jenis biaya mengizinkan. Jenis biaya di luar unit penerbit -> 403 di_luar_lingkup_unit; melanggar aturan penerimaan/jadwal -> 422 aturan_penerimaan (details.alasan: status_ditolak, hanya_tunggakan, belum_dibuka, sudah_ditutup, di","sc":["kasir:write"],"r":"object","it":"Objek"},"postKasirBayarDimuka":{"id":"postKasirBayarDimuka","m":"POST","path":"/v1/kasir/bayar-dimuka","tag":"Kasir: Penerimaan","sum":"Terima pembayaran di muka","ds":"Body: {\"uuid\", \"nim\", \"kode_biaya\", \"tahun_id\" (periode sasaran yang tagihannya belum terbit), \"jumlah\", \"metode\", \"referensi\", \"keterangan\"}. Hanya jenis biaya ber-saklar bayar_dimuka (paling cepat dimuka_hari sebelum jendela dibuka). Dicatat sebagai dana deposit menunggu periode (Deposit::catatDana sumber bayar_dimuka), dialokasikan otomatis saat tagihan terbit. Idempoten per uuid. Ditolak -> 422 aturan_penerimaan (dimuka_tidak_diizinkan, tagihan_sudah_terbit, dimuka_belum_dibuka, sudah_ditutup, status_ditolak, hanya_tunggakan).","sc":["kasir:write"],"r":"object","it":"Objek"},"getKasirDimukaByIdKwitansi":{"id":"getKasirDimukaByIdKwitansi","m":"GET","path":"/v1/kasir/dimuka/{id}/kwitansi","tag":"Kasir: Penerimaan","sum":"Kwitansi pembayaran di muka","ds":"Bukti kas masuk \"Pembayaran di muka – semester <periode>\" dari dana deposit: kwitansi resmi terpotret (sumber kasir_dimuka), kode verifikasi + QR, dicetak.","sc":["kasir:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"keu_mhs_deposit_dana.id"}],"r":"object","it":"Objek"},"postKasirDimukaByIdCetak":{"id":"postKasirDimukaByIdCetak","m":"POST","path":"/v1/kasir/dimuka/{id}/cetak","tag":"Kasir: Penerimaan","sum":"Catat cetak kwitansi di muka","ds":"Cetak pertama = asli; berikutnya bertanda SALINAN. {dicetak, salinan}.","sc":["kasir:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"keu_mhs_deposit_dana.id"}],"r":"object","it":"Objek"},"getKasirTransaksi":{"id":"getKasirTransaksi","m":"GET","path":"/v1/kasir/transaksi","tag":"Kasir: Penerimaan","sum":"Riwayat transaksi","ds":"Petugas tanpa kasir.laporan hanya melihat transaksinya sendiri. meta.ringkasan = total sah/batal sesuai saringan.","sc":["kasir:read"],"pa":[{"nm":"nim","in":"query","s":{"t":"string","rf":{"l":"/v1/mahasiswa","k":"nim","d":"/v1/mahasiswa/{nim}"}},"ds":"NIM"},{"nm":"kode_biaya","in":"query","s":{"t":"string"},"ds":"Kode biaya"},{"nm":"status","in":"query","s":{"t":"string"},"ds":"sah|batal"},{"nm":"sumber","in":"query","s":{"t":"string"},"ds":"kasir, lama, ..."},{"nm":"petugas","in":"query","s":{"t":"string"},"ds":"Username"},{"nm":"prodi","in":"query","s":{"t":"string","rf":{"l":"/v1/referensi/prodi","k":"kode_prodi","q":0}},"ds":"Kode prodi"},{"nm":"perangkat","in":"query","s":{"t":"string"},"ds":"keu_kasir_perangkat.id"},{"nm":"metode","in":"query","s":{"t":"string"},"ds":"tunai, transfer, ..."},{"nm":"q","in":"query","s":{"t":"string"},"ds":"NIM/nama/nomor"},{"nm":"dari","in":"query","s":{"t":"string"},"ds":"YYYY-MM-DD"},{"nm":"sampai","in":"query","s":{"t":"string"},"ds":"YYYY-MM-DD"},{"nm":"page","in":"query","s":{"t":"integer","min":1,"d":1},"ds":"Nomor halaman, mulai 1."},{"nm":"per_page","in":"query","s":{"t":"integer","min":1,"mx":100,"d":25},"ds":"Jumlah data per halaman (maksimal 100)."}],"r":"list","it":"Objek"},"getKasirTransaksiByIdKwitansi":{"id":"getKasi