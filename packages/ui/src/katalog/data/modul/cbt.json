{"key":"cbt","resources":[{"id":"/v1/cbt/jadwal-ujian","tag":"CBT: Ujian dari jadwal","title":"Jadwal UTS/UAS untuk ujian CBT","base":"/v1/cbt/jadwal-ujian","list":"getCbtJadwalUjian","actions":[],"children":[]},{"id":"/v1/cbt/kerjakan","tag":"CBT: Peserta ujian","title":"Peserta ujian","base":"/v1/cbt/kerjakan","item":"/v1/cbt/kerjakan/{id}","key":"id","get":"getCbtKerjakanById","actions":["postCbtKerjakanByIdMulai","postCbtKerjakanByIdJawab","postCbtKerjakanByIdLog","postCbtKerjakanByIdSelesai"],"children":[]},{"id":"/v1/cbt/latihan","tag":"CBT: Ujian percobaan","title":"Ujian latihan","base":"/v1/cbt/latihan","list":"getCbtLatihan","actions":[],"children":[]},{"id":"/v1/cbt/peserta","tag":"CBT: Peserta","title":"Peserta","base":"/v1/cbt/peserta","item":"/v1/cbt/peserta/{id}","key":"id","list":"getCbtPeserta","create":"postCbtPeserta","get":"getCbtPesertaById","update":"putCbtPesertaById","del":"deleteCbtPesertaById","actions":["postCbtPesertaByIdResetPerangkat","postCbtPesertaByIdTambahWaktu","postCbtPesertaByIdDiskualifikasi","postCbtPesertaByIdBukaKembali"],"children":["/v1/cbt/peserta/{id}/riwayat"]},{"id":"/v1/cbt/peserta/{id}/riwayat","tag":"CBT: Peserta","title":"Peserta: riwayat status","base":"/v1/cbt/peserta/{id}/riwayat","list":"getCbtPesertaByIdRiwayat","actions":[],"children":[],"parent":"/v1/cbt/peserta"},{"id":"/v1/cbt/saya","tag":"CBT: Peserta ujian","title":"Ujian saya","base":"/v1/cbt/saya","list":"getCbtSaya","actions":[],"children":[]},{"id":"/v1/cbt/sesi","tag":"CBT: Sesi dan pengawasan","title":"Sesi","base":"/v1/cbt/sesi","item":"/v1/cbt/sesi/{id}","key":"id","list":"getCbtSesi","create":"postCbtSesi","get":"getCbtSesiById","update":"putCbtSesiById","del":"deleteCbtSesiById","actions":["getCbtSesiByIdPantau","postCbtSesiByIdBuka","postCbtSesiByIdGantiToken","postCbtSesiByIdTutup"],"children":["/v1/cbt/sesi/{id}/riwayat"]},{"id":"/v1/cbt/sesi/{id}/riwayat","tag":"CBT: Sesi dan pengawasan","title":"Sesi: riwayat status","base":"/v1/cbt/sesi/{id}/riwayat","list":"getCbtSesiByIdRiwayat","actions":[],"children":[],"parent":"/v1/cbt/sesi"},{"id":"/v1/cbt/soal","tag":"CBT: Soal","title":"Soal","base":"/v1/cbt/soal","item":"/v1/cbt/soal/{id}","key":"id","list":"getCbtSoal","create":"postCbtSoal","get":"getCbtSoalById","update":"putCbtSoalById","del":"deleteCbtSoalById","actions":[],"children":["/v1/cbt/soal/{id}/riwayat"]},{"id":"/v1/cbt/soal/{id}/riwayat","tag":"CBT: Soal","title":"Soal: riwayat status","base":"/v1/cbt/soal/{id}/riwayat","list":"getCbtSoalByIdRiwayat","actions":[],"children":[],"parent":"/v1/cbt/soal"},{"id":"/v1/cbt/ujian","tag":"CBT: Ujian","title":"Ujian","base":"/v1/cbt/ujian","item":"/v1/cbt/ujian/{id}","key":"id","list":"getCbtUjian","create":"postCbtUjian","get":"getCbtUjianById","update":"putCbtUjianById","del":"deleteCbtUjianById","actions":["getCbtUjianByIdNilaiSiakad","postCbtUjianByIdNilaiSiakad","getCbtUjianByIdPeringkat","getCbtUjianByIdHasil","postCbtUjianByIdImporBankSoal","postCbtUjianByIdIsiPeserta","postCbtUjianByIdSiapkan","postCbtUjianByIdKembaliDraf","postCbtUjianByIdSelesaikan","postCbtUjianByIdArsipkan"],"children":["/v1/cbt/ujian/{id}/koreksi","/v1/cbt/ujian/{id}/nilai-siakad/riwayat","/v1/cbt/ujian/{id}/riwayat"]},{"id":"/v1/cbt/ujian/{id}/koreksi","tag":"CBT: Koreksi dan hasil","title":"Jawaban esai untuk dikoreksi","base":"/v1/cbt/ujian/{id}/koreksi","list":"getCbtUjianByIdKoreksi","actions":[],"children":[],"parent":"/v1/cbt/ujian"},{"id":"/v1/cbt/ujian/{id}/nilai-siakad/riwayat","tag":"CBT: Nilai ke SIAKAD","title":"Riwayat pengiriman nilai","base":"/v1/cbt/ujian/{id}/nilai-siakad/riwayat","list":"getCbtUjianByIdNilaiSiakadRiwayat","actions":[],"children":[],"parent":"/v1/cbt/ujian"},{"id":"/v1/cbt/ujian/{id}/riwayat","tag":"CBT: Ujian","title":"Ujian: riwayat status","base":"/v1/cbt/ujian/{id}/riwayat","list":"getCbtUjianByIdRiwayat","actions":[],"children":[],"parent":"/v1/cbt/ujian"}],"ops":{"getCbtUjianByIdNilaiSiakad":{"id":"getCbtUjianByIdNilaiSiakad","m":"GET","path":"/v1/cbt/ujian/{id}/nilai-siakad","tag":"CBT: Nilai ke SIAKAD","sum":"Pratinjau kirim nilai ke SIAKAD","ds":"Rencana penulisan nilai ujian ke t_mahasiswa_nilai: per peserta aksi tambah/ubah/sama/dilewati/ditolak beserta alasannya\n(belum selesai, esai belum dikoreksi, tidak ada KRS disetujui, syarat presensi UAS). `jenis_nilai` bawaan dari jenis ujian\n(uts = UTS, uas = UAS, kuis = Harian); `batas_input_nilai` menunjukkan apakah input nilai sedang dibuka per kelas (ADMIN bebas).","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"},{"nm":"jenis_nilai","in":"query","s":{"t":"string"},"ds":"Harian, Tugas, UTS, UAS, UP, SP"},{"nm":"nilai_ke","in":"query","s":{"t":"string"},"ds":"Untuk Harian/Tugas (bawaan 1)"}],"r":"object","it":"Objek"},"postCbtUjianByIdNilaiSiakad":{"id":"postCbtUjianByIdNilaiSiakad","m":"POST","path":"/v1/cbt/ujian/{id}/nilai-siakad","tag":"CBT: Nilai ke SIAKAD","sum":"Kirim nilai ke SIAKAD","ds":"Menulis baris tambah/ubah dari pratinjau ke t_mahasiswa_nilai (kolom sama seperti import nilai angka) dan m_log. Nilai akhir KHS dihitung SIAKAD seperti biasa. Body opsional: jenis_nilai, nilai_ke. 409 bila batas input nilai tutup atau tidak ada yang perlu dikirim.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"}],"b":{"ct":"application/json","ref":"Objek","s":{"t":"object","ds":"Baris data dengan nama kolom huruf kecil sesuai tabel SIAKAD."},"rq":1},"r":"object","it":"Objek"},"getCbtUjianByIdNilaiSiakadRiwayat":{"id":"getCbtUjianByIdNilaiSiakadRiwayat","m":"GET","path":"/v1/cbt/ujian/{id}/nilai-siakad/riwayat","tag":"CBT: Nilai ke SIAKAD","sum":"Riwayat pengiriman nilai","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"}],"r":"list","it":"Objek"},"postCbtUjianByIdNilaiSiakadByKirimBatal":{"id":"postCbtUjianByIdNilaiSiakadByKirimBatal","m":"POST","path":"/v1/cbt/ujian/{id}/nilai-siakad/{kirim}/batal","tag":"CBT: Nilai ke SIAKAD","sum":"Batalkan pengiriman nilai","ds":"Mengembalikan nilai lama (baris yang ditambahkan dihapus). Baris yang sudah diubah lagi di SIAKAD tidak ditimpa kecuali body `paksa: true`.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"},{"nm":"kirim","in":"path","s":{"t":"string"},"rq":1,"ds":"ID pengiriman"}],"b":{"ct":"application/json","ref":"Objek","s":{"t":"object","ds":"Baris data dengan nama kolom huruf kecil sesuai tabel SIAKAD."},"rq":1},"r":"object","it":"Objek"},"getCbtLatihan":{"id":"getCbtLatihan","m":"GET","path":"/v1/cbt/latihan","tag":"CBT: Ujian percobaan","sum":"Daftar ujian latihan","ds":"Ujian ber-latihan=1 yang siap dan punya sesi dibuka, beserta status dan nilai terakhir pengguna. Dibatasi prodi pengguna bila ujian berprodi.","sc":["cbt:read"],"r":"list","it":"Objek"},"postCbtLatihanByIdMulai":{"id":"postCbtLatihanByIdMulai","m":"POST","path":"/v1/cbt/latihan/{id}/mulai","tag":"CBT: Ujian percobaan","sum":"Mulai / ulangi ujian latihan","ds":"Mendaftarkan pengguna ke sesi latihan tanpa token pengawas, atau mengulang bila sudah selesai (jawaban lama dihapus). Hasilnya lembar ujian dan peserta_id untuk endpoint /cbt/kerjakan/{peserta_id}. Kirim header `X-Perangkat` (ID acak yang disimpan aplikasi ujian di perangkat); bersama User-Agent dipakai untuk kunci perangkat.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID ujian"}],"r":"object","it":"Objek"},"getCbtUjianByIdPeringkat":{"id":"getCbtUjianByIdPeringkat","m":"GET","path":"/v1/cbt/ujian/{id}/peringkat","tag":"CBT: Koreksi dan hasil","sum":"Peringkat peserta","ds":"Pengelola: peringkat semua peserta selesai (nilai sama = peringkat sama), peringkat dalam prodi, persentil, durasi. Peserta: posisinya sendiri bila ujian menampilkan hasil atau ujian latihan.","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"}],"r":"object","it":"Objek"},"getCbtSaya":{"id":"getCbtSaya","m":"GET","path":"/v1/cbt/saya","tag":"CBT: Peserta ujian","sum":"Ujian saya","ds":"Ujian (siap/selesai) tempat pengguna terdaftar sebagai peserta, dengan sesi, status, dan `bisa_mulai`.","sc":["cbt:read"],"r":"list","it":"Objek"},"postCbtKerjakanByIdMulai":{"id":"postCbtKerjakanByIdMulai","m":"POST","path":"/v1/cbt/kerjakan/{id}/mulai","tag":"CBT: Peserta ujian","sum":"Mulai ujian","ds":"Body: token (dari pengawas). Bila sudah mengerjakan, melanjutkan (sambung ulang) dari perangkat yang sama. Soal dan opsi diacak per peserta; batas waktu dihitung server (durasi + tambahan, tidak melewati akhir sesi). Mengembalikan lembar soal tanpa kunci. Kirim header `X-Perangkat` (ID acak yang disimpan aplikasi ujian di perangkat); bersama User-Agent dipakai untuk kunci perangkat.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID peserta (dari /cbt/saya)"}],"r":"object","it":"Objek"},"getCbtKerjakanById":{"id":"getCbtKerjakanById","m":"GET","path":"/v1/cbt/kerjakan/{id}","tag":"CBT: Peserta ujian","sum":"Lembar ujian","ds":"Soal, jawaban tersimpan, tanda ragu, sisa_detik. Bila waktu habis, ujian otomatis diakhiri dan dinilai; hasil tampil bila ujian `tampil_hasil`. Kirim header `X-Perangkat` (ID acak yang disimpan aplikasi ujian di perangkat); bersama User-Agent dipakai untuk kunci perangkat.","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID peserta"}],"r":"object","it":"Objek"},"postCbtKerjakanByIdJawab":{"id":"postCbtKerjakanByIdJawab","m":"POST","path":"/v1/cbt/kerjakan/{id}/jawab","tag":"CBT: Peserta ujian","sum":"Simpan jawaban","ds":"Body: soal_id, jawaban (bentuk sesuai jenis soal; null = kosongkan), ragu; atau `jawaban_banyak`: [{soal_id, jawaban, ragu}] untuk sinkron setelah koneksi putus. Ditolak setelah waktu habis (kelonggaran 30 detik). Kirim header `X-Perangkat` (ID acak yang disimpan aplikasi ujian di perangkat); bersama User-Agent dipakai untuk kunci perangkat.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID peserta"}],"r":"object","it":"Objek"},"postCbtKerjakanByIdLog":{"id":"postCbtKerjakanByIdLog","m":"POST","path":"/v1/cbt/kerjakan/{id}/log","tag":"CBT: Peserta ujian","sum":"Catat kejadian","ds":"Body: jenis (keluar_layar, pindah_tab, salin_tempel, layar_penuh, koneksi_putus, lainnya), detail. Keluar layar, pindah tab, dan salin-tempel menambah hitungan pelanggaran yang terlihat pengawas.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID peserta"}],"r":"object","it":"Objek"},"postCbtKerjakanByIdSelesai":{"id":"postCbtKerjakanByIdSelesai","m":"POST","path":"/v1/cbt/kerjakan/{id}/selesai","tag":"CBT: Peserta ujian","sum":"Selesai ujian","ds":"Mengakhiri dan menilai otomatis (esai menunggu koreksi). Kirim header `X-Perangkat` (ID acak yang disimpan aplikasi ujian di perangkat); bersama User-Agent dipakai untuk kunci perangkat.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID peserta"}],"r":"object","it":"Objek"},"getCbtSesiByIdPantau":{"id":"getCbtSesiByIdPantau","m":"GET","path":"/v1/cbt/sesi/{id}/pantau","tag":"CBT: Sesi dan pengawasan","sum":"Pantau sesi","ds":"Untuk pengawas sesi atau pengelola: token, ringkasan status, dan tiap peserta (progres terjawab, sisa waktu, pelanggaran, kejadian terakhir, perangkat terkunci). Tindakan lewat aksi peserta: reset-perangkat, tambah-waktu, diskualifikasi.","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/sesi","k":"id","d":"/v1/cbt/sesi/{id}"}},"rq":1,"ds":"ID sesi"}],"r":"object","it":"Objek"},"getCbtUjianByIdKoreksi":{"id":"getCbtUjianByIdKoreksi","m":"GET","path":"/v1/cbt/ujian/{id}/koreksi","tag":"CBT: Koreksi dan hasil","sum":"Jawaban esai untuk dikoreksi","ds":"Jawaban esai peserta yang sudah selesai dan belum dikoreksi (`semua=1` termasuk yang sudah). Pengelola.","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"},{"nm":"semua","in":"query","s":{"t":"string"},"ds":"1 = termasuk yang sudah dikoreksi"}],"r":"list","it":"Objek"},"postCbtJawabanByIdKoreksi":{"id":"postCbtJawabanByIdKoreksi","m":"POST","path":"/v1/cbt/jawaban/{id}/koreksi","tag":"CBT: Koreksi dan hasil","sum":"Beri skor jawaban","ds":"Body: skor (0 sampai poin soal). Nilai dan kelulusan peserta dihitung ulang; skor koreksi manual tidak ditimpa penilaian otomatis. Pengelola.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"ID jawaban"}],"r":"object","it":"Objek"},"getCbtUjianByIdHasil":{"id":"getCbtUjianByIdHasil","m":"GET","path":"/v1/cbt/ujian/{id}/hasil","tag":"CBT: Koreksi dan hasil","sum":"Hasil dan analisis butir","ds":"Statistik nilai (rata, median, simpangan baku, distribusi, lulus), daftar peserta, dan analisis butir: indeks kesukaran, daya beda kelompok atas/bawah 27%, sebaran pilihan. Pengelola.","sc":["cbt:read"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"}],"r":"object","it":"Objek"},"postCbtUjianByIdImporBankSoal":{"id":"postCbtUjianByIdImporBankSoal","m":"POST","path":"/v1/cbt/ujian/{id}/impor-bank-soal","tag":"CBT: Soal","sum":"Impor dari bank soal LMS","ds":"Body: `ids` [lms_bank_soal.id] atau saringan kode_mk/kode_prodi/jenis/tingkat/tag dengan `jumlah` (acak). Soal disalin (bank soal tidak berubah); yang sudah pernah diimpor dilewati. Pengelola.","sc":["cbt:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string","rf":{"l":"/v1/cbt/ujian","k":"id","d":"/v1/cbt/ujian/{id}"}},"rq":1,"ds":"ID ujian"}],"r":"object","it":"Objek"},"postCbtUjianByIdIsiPeserta":{"id":"pos