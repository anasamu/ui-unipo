],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"idpinjam"}],"r":"object","it":"Objek"},"postPerpustakaanPinjamanByIdHapus":{"id":"postPerpustakaanPinjamanByIdHapus","m":"POST","path":"/v1/perpustakaan/pinjaman/{id}/hapus","tag":"Perpustakaan: Sirkulasi","sum":"Hapus peminjaman","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Langkah tombol hapus menu lama: eksemplar kembali A lalu baris peminjaman dihapus (hanya yang masih P).","sc":["perpustakaan:write"],"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"idpinjam"}],"r":"object","it":"Objek"},"getPerpustakaanReservasi":{"id":"getPerpustakaanReservasi","m":"GET","path":"/v1/perpustakaan/reservasi","tag":"Perpustakaan: Sirkulasi","sum":"Daftar reservasi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Filter status (menunggu, siap, diambil, batal, kedaluwarsa), username, idpus. Reservasi siap yang lewat batas ambil otomatis kedaluwarsa dan eksemplarnya diteruskan ke antrean berikutnya.","sc":["perpustakaan:read"],"pa":[{"nm":"status","in":"query","s":{"t":"string"},"ds":"Status"},{"nm":"page","in":"query","s":{"t":"integer","min":1,"d":1},"ds":"Nomor halaman, mulai 1."},{"nm":"per_page","in":"query","s":{"t":"integer","min":1,"mx":100,"d":25},"ds":"Jumlah data per halaman (maksimal 100)."}],"r":"list","it":"Objek"},"postPerpustakaanReservasi":{"id":"postPerpustakaanReservasi","m":"POST","path":"/v1/perpustakaan/reservasi","tag":"Perpustakaan: Sirkulasi","sum":"Buat reservasi untuk anggota","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Body {\"username\", \"idpus\"}. Hanya bila semua eksemplar sedang dipinjam.","sc":["perpustakaan:write"],"r":"object","it":"Objek"},"postPerpustakaanReservasiByIdBatal":{"id":"postPerpustakaanReservasiByIdBatal","m":"POST","path":"/v1/perpustakaan/reservasi/{id}/batal","tag":"Perpustakaan: Sirkulasi","sum":"Batalkan reservasi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Body {\"catatan\"?}.","sc":["perpustakaan:write"],"pa":[{"nm":"id","in":"path","s":{"t":"st