ulan","get":"getPerpustakaanUsulanById","update":"putPerpustakaanUsulanById","del":"deletePerpustakaanUsulanById","actions":[],"children":[]}],"ops":{"getPerpustakaanKatalog":{"id":"getPerpustakaanKatalog","m":"GET","path":"/v1/perpustakaan/katalog","tag":"Perpustakaan: Katalog","sum":"Cari katalog (OPAC)","ds":"Tanpa token. sumber=siakad (bawaan, t_pustaka) atau slims (database SLiMS bila disambungkan). Filter q (judul, kata kunci, ISBN, ID pustaka, nama penulis/penerbit), katalog, jenis (P/B), rak, format, tahun, penulis, penerbit, tersedia=1. Tiap judul: jumlah eksemplar dan yang tersedia di rak.","pub":1,"pa":[{"nm":"q","in":"query","s":{"t":"string"},"ds":"Kata kunci"},{"nm":"sumber","in":"query","s":{"t":"string"},"ds":"siakad | slims"},{"nm":"katalog","in":"query","s":{"t":"string"},"ds":"Kode katalog"},{"nm":"jenis","in":"query","s":{"t":"string"},"ds":"P (boleh dipinjam) / B (baca di tempat)"},{"nm":"tersedia","in":"query","s":{"t":"string"},"ds":"1 = hanya yang ada di rak"},{"nm":"page","in":"query","s":{"t":"integer","min":1,"d":1},"ds":"Nomor halaman, mulai 1."},{"nm":"per_page","in":"query","s":{"t":"integer","min":1,"mx":100,"d":25},"ds":"Jumlah data per halaman (maksimal 100)."}],"r":"list","it":"Objek"},"getPerpustakaanKatalogByIdpus":{"id":"getPerpustakaanKatalogByIdpus","m":"GET","path":"/v1/perpustakaan/katalog/{idpus}","tag":"Perpustakaan: Katalog","sum":"Rincian koleksi","ds":"Tanpa token. Data koleksi, daftar eksemplar dengan status (ada, pinjam + jatuh tempo, rusak, hilang), dan antrean reservasi.","pub":1,"pa":[{"nm":"idpus","in":"path","s":{"t":"string","rf":{"l":"/v1/perpustakaan/katalog","k":"idpus","d":"/v1/perpustakaan/katalog/{idpus}"}},"rq":1,"ds":"ID pustaka"}],"r":"object","it":"Objek"},"getPerpustakaanSlimsKatalogById":{"id":"getPerpustakaanSlimsKatalogById","m":"GET","path":"/v1/perpustakaan/slims/katalog/{id}","tag":"Perpustakaan: Katalog","sum":"Rincian judul SLiMS","ds":"Tanpa token. Judul, penulis, penerbit, eksemplar dengan status pinjam dan jatuh tempo dari database SLiMS.","pub":1,"pa":[{"nm":"id","in":"path","s":{"t":"string"},"rq":1,"ds":"biblio_id SLiMS"}],"r":"object","it":"Objek"},"getPerpustakaanReferensiByJenis":{"id":"getPerpustakaanReferensiByJenis","m":"GET","path":"/v1/perpustakaan/referensi/{jenis}","tag":"Perpustakaan: Katalog","sum":"Referensi katalog","ds":"Tanpa token. Daftar katalog/rak/format/penulis/penerbit dengan jumlah judul.","pub":1,"pa":[{"nm":"jenis","in":"path","s":{"t":"string"},"rq":1,"ds":"katalog, rak, format, penulis, penerbit"}],"r":"list","it":"Objek"},"postPerpustakaanReferensiByJenis":{"id":"postPerpustakaanReferensiByJenis","m":"POST","path":"/v1/perpustakaan/referensi/{jenis}","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Tambah referensi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). rak/format: {nama jenis (mis. \"rak\"), keterangan}; katalog: {kode, nama, keterangan}; penulis: {kode, nama, kontak, biografi, gelardepan, gelarbelakang}; penerbit: {kode, nama, alamat, telpon, email, fax, website, kontak, keterangan}.","sc":["perpustakaan:write"],"pa":[{"nm":"jenis","in":"path","s":{"t":"string"},"rq":1,"ds":"katalog, rak, format, penulis, penerbit"}],"r":"object","it":"Objek"},"postPerpustakaanKoleksi":{"id":"postPerpustakaanKoleksi","m":"POST","path":"/v1/perpustakaan/koleksi","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Tambah koleksi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Body: idpus, judul, penulis (kode r_penulis), penerbit (kode r_penerbit), format (id r_format), rak (id r_rak), katalog (kode r_katalog) wajib; abstraksi, keyword, tahun, keteranganfisik, keterangan, harga, stok, hilang, rusak, denda (per hari), jenis (P/B), isbn, alih_bahasa. Query menu Data Koleksi + m_log.","sc":["perpustakaan:write"],"r":"object","it":"Objek"},"postPerpustakaanKoleksiByIdpus":{"id":"postPerpustakaanKoleksiByIdpus","m":"POST","path":"/v1/perpustakaan/koleksi/{idpus}","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Ubah koleksi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Kolom yang tidak dikirim tetap. Cover tetap diunggah lewat menu lama.","sc":["perpustakaan:write"],"pa":[{"nm":"idpus","in":"path","s":{"t":"string"},"rq":1,"ds":"ID pustaka"}],"r":"object","it":"Objek"},"postPerpustakaanKoleksiByIdpusHapus":{"id":"postPerpustakaanKoleksiByIdpusHapus","m":"POST","path":"/v1/perpustakaan/koleksi/{idpus}/hapus","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Hapus koleksi","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Koleksi beserta eksemplarnya (langkah hapus menu Data Koleksi). Ditolak bila ada eksemplar yang dipinjam.","sc":["perpustakaan:write"],"pa":[{"nm":"idpus","in":"path","s":{"t":"string"},"rq":1,"ds":"ID pustaka"}],"r":"none"},"postPerpustakaanKoleksiByIdpusEksemplar":{"id":"postPerpustakaanKoleksiByIdpusEksemplar","m":"POST","path":"/v1/perpustakaan/koleksi/{idpus}/eksemplar","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Tambah eksemplar","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Body {\"ideks\", \"tgl_masuk\"?, \"penerimaan\"?: P|L|S, \"status\"?: A|R|H}. ID barcode = idpus.ideks seperti menu lama.","sc":["perpustakaan:write"],"pa":[{"nm":"idpus","in":"path","s":{"t":"string"},"rq":1,"ds":"ID pustaka"}],"r":"object","it":"Objek"},"postPerpustakaanEksemplarByIdbarcode":{"id":"postPerpustakaanEksemplarByIdbarcode","m":"POST","path":"/v1/perpustakaan/eksemplar/{idbarcode}","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Ubah eksemplar","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Body {\"tgl_masuk\"?, \"penerimaan\"?, \"status\"?: A|R|H}. Status P hanya lewat sirkulasi.","sc":["perpustakaan:write"],"pa":[{"nm":"idbarcode","in":"path","s":{"t":"string"},"rq":1,"ds":"ID barcode"}],"r":"object","it":"Objek"},"postPerpustakaanEksemplarByIdbarcodeHapus":{"id":"postPerpustakaanEksemplarByIdbarcodeHapus","m":"POST","path":"/v1/perpustakaan/eksemplar/{idbarcode}/hapus","tag":"Perpustakaan: Pengelolaan koleksi","sum":"Hapus eksemplar","ds":"Pengelola perpustakaan (ADMIN, PUSTAKA). Dito