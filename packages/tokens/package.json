{
  "name": "unipo-ui-tokens",
  "version": "1.1.0",
  "description": "Design token UNIPO untuk web (CSS/SCSS/LESS/Tailwind), React Native, dan Android (Kotlin Compose/XML).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./scss": {
      "types": "./dist/css.d.ts",
      "default": "./dist/_tokens.scss"
    },
    "./less": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.less"
    },
    "./tailwind": "./dist/tailwind-preset.cjs",
    "./kotlin": "./dist/UnipoTheme.kt",
    "./android/colors.xml": "./dist/android/colors.xml",
    "./tokens.json": "./src/tokens.json",
    "./json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "less": "^4.9.1"
  },
  "keywords": [
    "unipo",
    "design-tokens",
    "tailwind",
    "react-native",
    "kotlin",
    "compose",
    "scss",
    "less"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anasamu/ui-unipo.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://api.unipo.ac.id/docs/panduan/ui",
  "publishConfig": {
    "access": "public"
  }
}
