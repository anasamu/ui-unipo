{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "unipo-ui": ["../../packages/ui/src/index.ts"],
      "unipo-ui/*": ["../../packages/ui/src/*/index.ts"]
    }
  },
  "include": ["src"]
}
